---
import { blobPaths, type BlobName } from '@/lib/blobs'

/**
 * Renders one decorative brand blob.
 *
 * Use on the peach background with `blend-multiply` so overlapping blobs mix.
 * Always decorative — `aria-hidden` is applied here rather than at each call
 * site so it cannot be forgotten.
 */
interface Props {
  name: BlobName
  class?: string
}

const { name, class: className = '' } = Astro.props
const { viewBox, d } = blobPaths[name]
---

<svg
  viewBox={viewBox}
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <path d={d} fill="currentColor" />
</svg>
