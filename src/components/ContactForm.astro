---
/**
 * Netlify Forms.
 *
 * `data-netlify="true"` is all that is required — Netlify detects the form in
 * the built HTML at deploy time and provisions the endpoint. There is no API
 * route, no key and no third-party service.
 *
 * The previous Next.js build had these same fields but no <form> element and no
 * handler, so filling it in and pressing the button did nothing at all.
 *
 * `netlify-honeypot` names a field bots fill in and humans never see; Netlify
 * silently discards any submission where it is non-empty.
 */
---

<form
  name="enquiry"
  method="POST"
  action="/thanks/"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="space-y-6"
>
  <!-- Fallback for JS-less form detection on some Netlify build paths -->
  <input type="hidden" name="form-name" value="enquiry" />

  <p class="hidden">
    <label>
      Don&rsquo;t fill this in if you&rsquo;re human
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <label class="field-label" for="firstName">
        First Name <span class="text-orange-text" aria-hidden="true">*</span>
      </label>
      <input
        class="field-input"
        type="text"
        id="firstName"
        name="firstName"
        autocomplete="given-name"
        required
      />
    </div>
    <div>
      <label class="field-label" for="lastName">
        Last Name <span class="text-orange-text" aria-hidden="true">*</span>
      </label>
      <input
        class="field-input"
        type="text"
        id="lastName"
        name="lastName"
        autocomplete="family-name"
        required
      />
    </div>
  </div>

  <div>
    <label class="field-label" for="email">
      Email <span class="text-orange-text" aria-hidden="true">*</span>
    </label>
    <input
      class="field-input"
      type="email"
      id="email"
      name="email"
      autocomplete="email"
      required
    />
  </div>

  <div>
    <label class="field-label" for="phone">Phone Number</label>
    <input
      class="field-input"
      type="tel"
      id="phone"
      name="phone"
      autocomplete="tel"
    />
  </div>

  <div>
    <label class="field-label" for="subject">Subject</label>
    <input class="field-input" type="text" id="subject" name="subject" />
  </div>

  <div>
    <label class="field-label" for="message">
      Your Message <span class="text-orange-text" aria-hidden="true">*</span>
    </label>
    <textarea class="field-input resize-y" id="message" name="message" rows="6" required
    ></textarea>
  </div>

  <p class="text-xs text-ink-muted">
    Fields marked <span class="text-orange-text">*</span> are required. We use your
    details only to respond to your enquiry &mdash; see our
    <a href="/privacy/" class="text-teal underline underline-offset-2">privacy notice</a>.
  </p>

  <button type="submit" class="btn btn-primary w-full">Send Message</button>
</form>
